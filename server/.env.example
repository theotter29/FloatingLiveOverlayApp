# ========== Server Configuration ==========
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000

# ========== CORS Configuration ==========
CORS_ORIGIN=*

# ========== TikTok API ==========
# Dapatkan dari: https://developer.tiktok.com/
TIKTOK_API_KEY=your_api_key_here
TIKTOK_ACCESS_TOKEN=your_access_token_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# ========== Instagram API ==========
# Dapatkan dari: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id

# ========== YouTube API ==========
# Dapatkan dari: https://developers.google.com/youtube/v3
YOUTUBE_API_KEY=your_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id

# ========== Twitch API (Optional) ==========
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_ACCESS_TOKEN=your_access_token_here
TWITCH_CHANNEL_NAME=your_channel_name

# ========== Database (Optional) ==========
DATABASE_URL=mongodb://localhost:27017/live_overlay
DATABASE_USER=admin
DATABASE_PASSWORD=password

# ========== Redis (Optional - untuk caching) ==========
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========== Notification Services ==========
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_PROJECT_ID=your_project_id

# OneSignal (Alternative)
ONESIGNAL_APP_ID=your_app_id
ONESIGNAL_API_KEY=your_api_key

# ========== Email Service (Optional) ==========
SENDGRID_API_KEY=your_sendgrid_api_key
SENDER_EMAIL=noreply@floatingoverlay.app

# ========== Mobile App Config ==========
APP_NAME=FloatingLiveOverlay
APP_VERSION=1.0.0
BUNDLE_ID=com.floatingliveoverlay
PACKAGE_NAME=com.floatingliveoverlay

# ========== Analytics (Optional) ==========
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
SENTRY_DSN=https://your-sentry-dsn

# ========== Logging ==========
LOG_LEVEL=debug
LOG_FILE=/var/log/live-overlay/app.log

# ========== Feature Flags ==========
ENABLE_TIKTOK_INTEGRATION=true
ENABLE_INSTAGRAM_INTEGRATION=true
ENABLE_YOUTUBE_INTEGRATION=true
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=true
